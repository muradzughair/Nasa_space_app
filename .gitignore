# Local-only material (kept on disk, never committed)
_local/
competition_roles/

# Secrets and environment
.env
.env.*
!.env.example

# Large raw data: download it yourself, see README.md
data/raw/moon/*
data/raw/earth/*
data/raw/mars/*.img
data/raw/mars/*.IMG
data/raw/**/*.tif
data/raw/**/*.tiff
data/raw/**/*.IMG
data/raw/**/*.img
!data/raw/**/.gitkeep

# Python
__pycache__/
*.pyc
.venv/
venv/

# Node
node_modules/

# Editors and operating systems
.DS_Store
Thumbs.db
desktop.ini
.vscode/
.idea/
*.swp

# Unfinished browser downloads
*.crdownload
*.part
*.tmp

# Heavy source models and CAD (keep them in _local)
*.blend
*.blend1
*.stl
*.STL
*.usdz

# Word documents and generated screenshots (kept locally, regenerable)
*.docx
~$*
tests/previews/
