# Copy to .env.local and fill in what you have. Everything is optional:
# with no values set the app runs on keyless public data sources.

# Cesium ion access token (free tier at https://ion.cesium.com/tokens).
# When set, the app can use Bing Maps Aerial imagery and Cesium World Terrain
# (with ocean water mask) through ion.
VITE_CESIUM_ION_TOKEN=

# Base URL of a Nominatim server used for place search and reverse geocoding.
# Defaults to the public OpenStreetMap instance, which allows light use only
# (max 1 request/second, no autocomplete). Point this at your own instance
# for anything heavier.
VITE_NOMINATIM_URL=https://nominatim.openstreetmap.org

# Set to "false" to never send search text or clicked coordinates to
# Nominatim. Country, ocean and major-city lookup still work offline from
# the bundled Natural Earth data.
VITE_ONLINE_GEOCODING=true

# Build-time only (npm run grid): a NASA Earthdata user token, needed to
# download the global MODIS temperature and vegetation grids. Create one at
# https://urs.earthdata.nasa.gov/ -> Generate Token. It has no VITE_ prefix,
# so it is never included in the browser bundle.
EARTHDATA_TOKEN=
